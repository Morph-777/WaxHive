<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="VolumeButton" parent="GtkBox">
    <property name="spacing">4</property>
    <property name="valign">center</property>
    <child>
      <object class="GtkToggleButton" id="_mute_button">
        <property name="icon-name">audio-volume-high-symbolic</property>
        <property name="tooltip-text" translatable="yes">Mute/Unmute</property>
        <style><class name="flat"/></style>
        <accessibility><property name="label" translatable="yes">Mute/Unmute</property></accessibility>
      </object>
    </child>
    <child>
      <object class="GtkScale" id="_scale">
        <property name="width-request">140</property>
        <property name="draw-value">false</property>
        <property name="valign">center</property>
        <property name="tooltip-text" translatable="yes">Volume</property>
        <property name="adjustment">
          <object class="GtkAdjustment" id="_adjustment">
            <property name="page-increment">0.02</property>
            <property name="step-increment">0.005</property>
            <property name="lower">0.0</property>
            <property name="upper">1.0</property>
            <property name="value">1.0</property>
          </object>
        </property>
        <accessibility><property name="label" translatable="yes">Volume</property></accessibility>
      </object>
    </child>
  </template>
</interface>
