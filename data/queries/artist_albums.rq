# Inputs: ~artist
SELECT
  ?id
  ?title
  ?publicationDate
WHERE {
  SERVICE <dbus:{bus_name}> {
    GRAPH tracker:Audio {
      SELECT DISTINCT
        ?album AS ?id
        nie:title(?album) AS ?title
        YEAR(nie:contentCreated(?song)) AS ?publicationDate
      WHERE {
        ?song a nmm:MusicPiece;
                nmm:musicAlbum ?album .
        OPTIONAL { ?album nmm:albumArtist ?album_artist . }
        FILTER (COALESCE(?album_artist,
          IRI("urn:gnome-music:unknown-album-artist")) = ~artist)
        {location_filter}
      }
      GROUP BY ?album
      ORDER BY ?publicationDate ?album
    }
  }
}