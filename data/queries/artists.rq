SELECT
  ?id
  ?artist
  ?albumCount
WHERE {
  SERVICE <dbus:{bus_name}> {
    GRAPH tracker:Audio {
      SELECT
        ?id
        ?artist
        (COUNT(DISTINCT ?album) AS ?albumCount)
      WHERE {
        ?song a nmm:MusicPiece; nmm:musicAlbum ?album .
        OPTIONAL { ?album nmm:albumArtist ?album_artist . }
        BIND(COALESCE(?album_artist,
          IRI("urn:gnome-music:unknown-album-artist")) AS ?id)
        BIND(COALESCE(nmm:artistName(?album_artist), "") AS ?artist)
        {location_filter}
      }
      GROUP BY ?id ?artist
      ORDER BY ?artist
    }
  }
}
